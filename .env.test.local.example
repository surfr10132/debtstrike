# Local Phase 2 test environment template
# Copy this file to `.env.test.local` and adjust values as needed.

# App base URL for local smoke scripts
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:4010

# Keep checkout + mailing side effects in test mode
DEBTSTRIKE_TEST_MODE=true
DEBTSTRIKE_ENABLE_TEST_ENDPOINTS=true

# Local-only helper: bypass Anthropic call in /api/analyze-response
DEBTSTRIKE_PHASE2_MOCK_ANALYSIS=true

# Optional auth for reminder route. Leave blank for local smoke runs.
CRON_SECRET=

# Optional third-party integrations (leave blank for isolated local tests)
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# LOB_API_KEY_TEST=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_TAB=Sheet1
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_CLIENTS_ROOT_PATH=/DebtStrike Clients
# DROPBOX_SHARED_LINK=
